[Unit]
Description=CMP 90HX PCIe Gen2 unlock (minimal 2-mask, auto BDF) - compute unlock is automatic at module load
After=multi-user.target
# If you auto-start a miner / GPU workload, order it After= this unit.

[Service]
Type=oneshot
ExecStartPre=/bin/rm -f /var/lib/cmpunlocker-rs/rejoin16-next-write.bin
# Bring the card up on the stock module first, then hand it to the patched one.
# The patched module cannot be the first nvidia load of a power cycle (see
# scripts/cmp90hx-gen2-handoff.sh).
ExecStartPre=/opt/cmp90hx-gen2/cmp90hx-gen2-handoff.sh
ExecStart=/opt/cmp90hx-gen2/cmp90hx-gen2-minimal.sh
TimeoutStartSec=900
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
